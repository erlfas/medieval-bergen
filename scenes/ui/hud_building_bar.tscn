layout_mode = 2
size_flags_vertical = 3

[node name="VBoxContent" type="VBoxContainer" parent="ModalCabinGuide/VBox/ScrollGuide"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="LabelIntro" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 1)
theme_override_font_sizes/font_size = 12
text = "I året 1360 trues nybyggeren i Bergen av bitende vestlandskulde, høststormer og ulver. En Laftehytte (Årestue) er din eneste trygge havn for å overleve."
autowrap_mode = 2

[node name="Step1" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "1. Felle gran og furu (Tree Chopping)"

[node name="Step1Desc" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.8, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "• Finn et høyreist grantre og hogg med øksen (10 hogg med Venstreklikk eller [E]).
• Treet får gradvise øksehogg, svaier og faller med realistisk fysikk.
• Stammen kløyves til bæreklare tømmerstokker."
autowrap_mode = 2

[node name="Step2" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "2. Bære tømmer til byggeplassen (Hauling Logs)"

[node name="Step2Desc" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.8, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "• Gå bort til en stokk og trykk [E] for å løfte den opp i favnen.
• Bær stokken til tomten din. Du kan legge den ned med [E] eller [G].
• Tips: Når du bærer en stokk og trykker [B] for å bygge, brukes stokken direkte i bygget (-1 tømmerkostnad)!"
autowrap_mode = 2

[node name="Step3" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "3. Samle stein, never og torv (Materials)"

[node name="Step3Desc" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.8, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "• Grunnmur & Ildsted: Samle flat skifer og granitt fra ur og elveleie (4 stein).
• Vanntetting: Høst hvit bjørkenever (4 never) fra bjørketrær til taktekking.
• Grønt torvtak: Skjær gresstorv (4 torv) fra engen for isolasjon mot vinterfrost."
autowrap_mode = 2

[node name="Step4" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "4. Bygge laftehytten (Placing & Aligning)"

[node name="Step4Desc" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.8, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "• Trykk [B] for å åpne byggemodus. Velg 'Complete Laftehytte' eller bygg trinnvis (Trinn 1-4).
• Trykk [R] for å rotere døråpningen (se dør-indikatoren på den grønne forhåndsvisningen).
• Venstreklikk plasserer hytten på bakken."
autowrap_mode = 2

[node name="Step5" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = "5. Årestuen og overlevelse (Warmth & Hearth)"

[node name="Step5Desc" type="Label" parent="ModalCabinGuide/VBox/ScrollGuide/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.8, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "• Gå inn gjennom døren: Hyttens tak og vegger gir 100% beskyttelse mot regn, snø og vind.
• Det sentrale åre-ildstedet gir 360 graders varme, røyken stiger ut av ljoren i taket, og du kan steke reinsdyrkjøtt [H]."
autowrap_mode = 2
